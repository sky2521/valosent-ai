# VALOSENT AI — Environment Configuration Example
# Copy this file to .env and fill in your credentials.

PORT=5000
FLASK_ENV=development
DEBUG=false
SECRET_KEY=change-me-in-production

# ------------------------------------------------------------------
# Google OAuth ("Continue with Google" via Authlib)
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web application)
# Authorized JavaScript origins : http://127.0.0.1:5000
# Authorized Redirect URI       : http://127.0.0.1:5000/login/google/callback
# ------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------
# Gmail 6-Digit OTP Verification (via SMTP STARTTLS on smtp.gmail.com:587)
# Create a 16-character Gmail App Password at https://myaccount.google.com/apppasswords
# NOTE: If left blank, VALOSENT AI automatically activates Dev Fallback Mode
# and prints the 6-digit OTP directly in the Flask terminal console!
# ------------------------------------------------------------------
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ------------------------------------------------------------------
# Database Storage (defaults to persistent local SQLite valosent.db)
# ------------------------------------------------------------------
VALOSENT_STORAGE=sqlite
# DATABASE_URL=sqlite:///valosent.db
# Optional Supabase Cloud Postgres mode (only used if VALOSENT_STORAGE=supabase):
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
